<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="760dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:text="TERMINALLIKE"
                android:textColor="#9A948A"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_subtitle"
                android:textColor="#E8E4DC"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_url"
                android:textColor="#CFC9BE"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:hint="@string/hint_url"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#E8E4DC"
                android:textColorHint="#6E6A63"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/check_bright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:buttonTint="#E8E4DC"
                android:text="@string/label_screen_bright"
                android:textColor="#CFC9BE"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:text="@string/btn_save"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_text"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_preview"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:text="@string/btn_preview"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_text"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_system_settings"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/btn_bg"
                    android:text="@string/btn_system_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/input_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/adb_hint_title"
                    android:textColor="#E8E4DC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/adb_hint_body"
                    android:textColor="#9A948A"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
