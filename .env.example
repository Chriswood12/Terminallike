# -----------------------------------------------------------------------------
# Terminallike — TRMNL-inspireret 4K TV Kalender & AI Dagsoverblik
# Kopiér til .env ved lokal kørsel, eller tilføj i Vercel → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Serverport (kun til lokal Node.js server)
PORT=3000

# Navn og valgfri hilsen på skærmen
PERSON_NAME=Anne
PERSONAL_NOTE=Hav en skøn dag — jeg står for aftensmaden i aften.

# Private .ics kalender-links (adskilt af komma eller linjeskift)
# Understøtter Google Kalender ("Hemmelig adresse i iCal-format") og Apple iCloud (webcal:// eller https://).
# Du kan sætte et navn foran hvert link med "Navn|URL".
# Lad den stå tom for at køre i Demo-tilstand.
# Eksempel:
# ICS_URLS=Privat|https://calendar.google.com/calendar/ical/.../basic.ics,Arbejde|webcal://p123-caldav.icloud.com/published/2/...
ICS_URLS=

# By & Vejr (Open-Meteo — helt gratis, ingen API-nøgle nødvendig)
LOCATION_NAME=København, DK
LOCATION_LAT=55.6761
LOCATION_LON=12.5683
TIMEZONE=Europe/Copenhagen
WEATHER_UNITS=celsius

# AI Dagsoverblik (valgfrit — bruger ellers indbygget dansk smart-overblik)
# AI_PROVIDER: auto | gemini | openai | anthropic | none
AI_PROVIDER=auto
# Valgfri model-overstyring (standard: gemini-2.5-flash, gpt-4o-mini, claude-3-5-haiku-latest)
AI_MODEL=
# Indsæt én af nøglerne herunder:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cache (minutter)
AI_CACHE_MINUTES=45
ICS_CACHE_MINUTES=5
WEATHER_CACHE_MINUTES=15
