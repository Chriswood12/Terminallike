# -----------------------------------------------------------------------------
# Terminallike — TRMNL-Inspired 4K TV Calendar & AI Briefing
# Copy this file to .env for local development, or add these in Vercel Settings.
# -----------------------------------------------------------------------------

# Server port (local Node.js server only)
PORT=3000

# Display personalization
PERSON_NAME=Maya
PERSONAL_NOTE=Have a wonderful day — dinner is on me tonight.

# Private .ics Calendar Feeds (comma or newline separated)
# Supports Google Calendar "Secret address in iCal format" and Apple iCloud
# webcal:// or https:// URLs. Optionally prefix each URL with "Label|".
# Leave empty to run in realistic Demo Mode.
# Example:
# ICS_URLS=Personal|https://calendar.google.com/calendar/ical/.../basic.ics,Work|webcal://p123-caldav.icloud.com/published/2/...
ICS_URLS=

# Location & Weather (Open-Meteo — completely free, no API key required)
LOCATION_NAME=San Francisco, CA
LOCATION_LAT=37.7749
LOCATION_LON=-122.4194
TIMEZONE=America/Los_Angeles
WEATHER_UNITS=fahrenheit

# AI Daily Summary (optional — falls back to smart local summary if unset)
# AI_PROVIDER: auto | gemini | openai | anthropic | none
AI_PROVIDER=auto
# Optional model override (defaults: gemini-2.5-flash, gpt-4o-mini, claude-3-5-haiku-latest)
AI_MODEL=
# Provide any one of the API keys below:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Caching (minutes)
AI_CACHE_MINUTES=45
ICS_CACHE_MINUTES=5
WEATHER_CACHE_MINUTES=15
